# ==========================================
# DocuFlow AI Platform Environment Variables
# ==========================================

# 1. UiPath Webhook Security
UIPATH_API_KEY=your-secure-uipath-api-key-here

# 2. Vector Database: Pinecone (Recommended Free Cloud Vector DB)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=rag-documents
PINECONE_HOST=https://your-index-host.pinecone.io

# (Optional fallback) Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX_NAME=documents-rag-index

# 3. AI Provider: Google Gemini (Recommended Free) or OpenAI
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 4. App Configuration
NODE_ENV=development
